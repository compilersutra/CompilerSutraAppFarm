{
  "version": "3.4.0",
  "source": {
    "url": "https://github.com/openssl/openssl.git",
    "ref": "openssl-3.4.0"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "custom",
    "commands": [
      ["./Configure", "linux-x86_64", "no-docs", "no-shared"],
      ["make", "-j4"]
    ]
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "./apps/openssl version && printf 'csfarm' | ./apps/openssl enc -aes-256-cbc -pass pass:csfarm -out /tmp/csfarm-ossl.enc && ./apps/openssl enc -d -aes-256-cbc -pass pass:csfarm -in /tmp/csfarm-ossl.enc | grep -qx csfarm"
    ],
    "timeout_sec": 120,
    "env": {"LD_LIBRARY_PATH": "."}
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "sh",
        "-c",
        "printf 'csfarm' | ./apps/openssl enc -aes-256-cbc -pass pass:csfarm >/dev/null"
      ]
    }
  }
}
