{
  "version": "5.7.4",
  "source": {
    "url": "https://github.com/wolfSSL/wolfssl.git",
    "ref": "v5.7.4-stable"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "test -f src/.libs/libwolfssl.so || test -f src/.libs/libwolfssl.a"
    ],
    "timeout_sec": 30
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "sh",
        "-c",
        "test -f src/.libs/libwolfssl.so || test -f src/.libs/libwolfssl.a"
      ]
    }
  }
}
