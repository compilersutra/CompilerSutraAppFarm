{
  "version": "2.0.20",
  "source": {
    "url": "https://github.com/eclipse-mosquitto/mosquitto.git",
    "ref": "v2.0.20"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "cmake",
    "args": ["-DDOCUMENTATION=OFF", "-DWITH_CJSON=OFF"]
  },
  "test": {
    "command": ["sh", "-c", "test -x build/src/mosquitto || test -x build/mosquitto"],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": ["sh", "-c", "test -x build/src/mosquitto || test -x build/mosquitto"]
    }
  }
}
