{
  "version": "1.27.3",
  "source": {
    "url": "https://github.com/nginx/nginx.git",
    "ref": "release-1.27.3"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "custom",
    "commands": [
      [
        "./auto/configure",
        "--prefix=./nginx-prefix",
        "--with-http_ssl_module",
        "--without-http_rewrite_module"
      ],
      ["make", "-j4"]
    ]
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "mkdir -p nginx-prefix/logs && printf 'error_log logs/error.log;\\npid logs/nginx.pid;\\nevents{}\\nhttp{server{listen 127.0.0.1:18080;}}\\n' > /tmp/csfarm-nginx.conf && ./objs/nginx -t -p \"$PWD/nginx-prefix\" -c /tmp/csfarm-nginx.conf"
    ],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": ["./objs/nginx", "-V"]
    }
  }
}
