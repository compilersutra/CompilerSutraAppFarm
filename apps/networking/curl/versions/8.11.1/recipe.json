{
  "version": "8.11.1",
  "source": {
    "url": "https://github.com/curl/curl.git",
    "ref": "curl-8_11_1"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": ["--with-openssl", "--without-libpsl"]
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "./src/curl --version | grep -qi curl && ./src/curl -s -o /tmp/csfarm-curl.out file:///etc/hosts && test -s /tmp/csfarm-curl.out"
    ],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": ["./src/curl", "-s", "-o", "/dev/null", "file:///etc/hosts"]
    }
  }
}
