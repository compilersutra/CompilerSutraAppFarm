{
  "version": "8.11.1",
  "source": {
    "url": "https://github.com/curl/curl.git",
    "ref": "curl-8_11_1"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": ["--with-openssl", "--without-libpsl"]
  },
  "test": {
    "command": ["./src/curl", "--version"],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": ["./src/curl", "--version"]
    }
  }
}
