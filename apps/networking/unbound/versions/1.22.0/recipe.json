{
  "version": "1.22.0",
  "source": {
    "url": "https://github.com/NLnetLabs/unbound.git",
    "ref": "release-1.22.0"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "./unbound",
      "-V"
    ],
    "timeout_sec": 1800
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "./unbound",
        "-V"
      ]
    }
  }
}
