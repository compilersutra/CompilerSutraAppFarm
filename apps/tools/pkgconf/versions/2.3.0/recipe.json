{
  "version": "2.3.0",
  "source": {
    "url": "https://github.com/pkgconf/pkgconf.git",
    "ref": "pkgconf-2.3.0"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "./pkgconf",
      "--version"
    ],
    "timeout_sec": 1800
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "./pkgconf",
        "--version"
      ]
    }
  }
}
