{
  "version": "3.3.6",
  "source": {
    "kind": "archive",
    "url": "https://cache.ruby-lang.org/pub/ruby/3.3/ruby-3.3.6.tar.gz",
    "ref": ""
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": [
      "--disable-install-doc",
      "--disable-install-rdoc",
      "--disable-yjit"
    ]
  },
  "test": {
    "command": [
      "./ruby",
      "-e",
      "raise 'bad' unless 1+1==2; puts 'ok'"
    ],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "./ruby",
        "-e",
        "1000.times { |i| i*i }"
      ]
    }
  }
}
