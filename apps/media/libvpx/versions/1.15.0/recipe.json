{
  "version": "1.15.0",
  "source": {
    "url": "https://chromium.googlesource.com/webm/libvpx",
    "ref": "v1.15.0"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "./vpxenc",
      "--help"
    ],
    "timeout_sec": 1800
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "./vpxenc",
        "--help"
      ]
    }
  }
}
