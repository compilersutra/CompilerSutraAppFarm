{
  "version": "11.4.4",
  "source": {
    "url": "https://github.com/MariaDB/server.git",
    "ref": "mariadb-11.4.4"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "cmake",
    "args": [
      "-DWITH_UNIT_TESTS=OFF",
      "-DPLUGIN_COLUMNSTORE=NO",
      "-DCONNECT_WITH_MYSQL=OFF"
    ]
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "test -x build/sql/mariadbd || test -x sql/mariadbd || find build -name mariadbd -type f | head -1 | grep -q ."
    ],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "sh",
        "-c",
        "test -x build/sql/mariadbd || test -x sql/mariadbd || find build -name mariadbd -type f | head -1 | grep -q ."
      ]
    }
  }
}
