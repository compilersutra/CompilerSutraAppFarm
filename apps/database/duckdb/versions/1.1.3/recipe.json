{
  "version": "1.1.3",
  "source": {
    "url": "https://github.com/duckdb/duckdb.git",
    "ref": "v1.1.3"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "custom",
    "commands": [
      [
        "sh",
        "-c",
        "GEN=ninja make -j$(nproc) || make -j$(nproc)"
      ]
    ]
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "test -x build/release/duckdb || test -x build/duckdb"
    ],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "sh",
        "-c",
        "test -x build/release/duckdb || test -x build/duckdb"
      ]
    }
  }
}
