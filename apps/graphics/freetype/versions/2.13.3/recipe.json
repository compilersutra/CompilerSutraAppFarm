{
  "version": "2.13.3",
  "source": {
    "url": "https://gitlab.freedesktop.org/freetype/freetype.git",
    "ref": "VER-2-13-3"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "cmake",
    "args": ["-DBUILD_SHARED_LIBS=ON"]
  },
  "test": {
    "command": ["sh", "-c", "test -f build/libfreetype.a || test -f build/libfreetype.so"],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": ["sh", "-c", "test -f build/libfreetype.a || test -f build/libfreetype.so"]
    }
  }
}
