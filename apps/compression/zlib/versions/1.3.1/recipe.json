{
  "version": "1.3.1",
  "source": {
    "url": "https://github.com/madler/zlib.git",
    "ref": "v1.3.1"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "./minigzip",
      "-h"
    ],
    "timeout_sec": 1800
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "./minigzip",
        "-h"
      ]
    }
  }
}
