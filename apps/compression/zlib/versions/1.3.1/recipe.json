{
  "version": "1.3.1",
  "source": {
    "url": "https://github.com/madler/zlib.git",
    "ref": "v1.3.1"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "printf 'csfarm-zlib' | ./minigzip | ./minigzip -d | grep -qx 'csfarm-zlib'"
    ],
    "timeout_sec": 120
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "sh",
        "-c",
        "printf 'csfarm-zlib' | ./minigzip | ./minigzip -d >/dev/null"
      ]
    }
  }
}
