{
  "version": "2.8",
  "source": {
    "url": "https://git.savannah.gnu.org/git/gsl.git",
    "ref": "release-2-8"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": ["--disable-shared"]
  },
  "test": {
    "command": ["sh", "-c", "test -f .libs/libgsl.a || test -f libgsl.a"],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": ["sh", "-c", "test -f .libs/libgsl.a || test -f libgsl.a"]
    }
  }
}
