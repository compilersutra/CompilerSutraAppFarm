{
  "version": "5.9",
  "source": {
    "url": "https://github.com/zsh-users/zsh.git",
    "ref": "zsh-5.9"
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "./Src/zsh",
      "--version"
    ],
    "timeout_sec": 1800
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 1,
      "repeat_runs": 3,
      "workload": [
        "./Src/zsh",
        "--version"
      ]
    }
  }
}
