{
  "version": "3.11",
  "source": {
    "kind": "archive",
    "url": "https://ftp.gnu.org/gnu/grep/grep-3.11.tar.gz",
    "ref": ""
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "./src/grep",
      "--version"
    ],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": [
        "./src/grep",
        "--version"
      ]
    }
  }
}
