{
  "version": "3.4.6",
  "source": {
    "kind": "archive",
    "url": "https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz",
    "ref": ""
  },
  "toolchain": {
    "cc": "${CC}",
    "cxx": "${CXX}",
    "cflags": [],
    "cxxflags": [],
    "ldflags": []
  },
  "build": {
    "system": "configure",
    "args": []
  },
  "test": {
    "command": [
      "sh",
      "-c",
      "test -n \"$(find . -path '*/.libs/libffi.a' -o -path '*/.libs/libffi.so' 2>/dev/null | head -1)\""
    ],
    "timeout_sec": 60
  },
  "perf": {
    "csperf": {
      "enabled": true,
      "backend": "cpu",
      "warmup_runs": 0,
      "repeat_runs": 1,
      "workload": [
        "sh",
        "-c",
        "test -n \"$(find . -path '*/.libs/libffi.a' 2>/dev/null | head -1)\""
      ]
    }
  }
}
